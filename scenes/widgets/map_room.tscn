[sub_resource type="Shader" id="Shader_scan"]
code = "shader_type canvas_item;\n\nvoid fragment() {\n    vec4 tex = texture(TEXTURE, UV);\n    float scan = 0.78 + 0.22 * step(0.55, fract(UV.y * 18.0));\n    vec3 holo = mix(tex.rgb, vec3(0.25, 0.85, 1.0), 0.34);\n    COLOR = vec4(holo * scan, tex.a);\n}"

