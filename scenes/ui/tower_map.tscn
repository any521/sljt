[sub_resource type="Shader" id="Shader_grid"]
code = "shader_type canvas_item;\n\nuniform vec4 grid_color : source_color = vec4(0.20, 0.72, 0.92, 0.12);\nuniform vec4 scan_color : source_color = vec4(0.35, 0.85, 1.0, 0.055);\n\nvoid fragment() {\n    vec2 p = UV * vec2(940.0, 940.0);\n    float gx = step(0.965, fract(p.x / 56.0));\n    float gy = step(0.965, fract(p.y / 56.0));\n    float scan = step(0.78, fract(p.y / 5.0));\n    float vignette = 1.0 - smoothstep(0.36, 0.75, distance(UV, vec2(0.5)));\n    vec4 c = grid_color * max(gx, gy);\n    c += scan_color * scan;\n    c.a *= 0.55 + 0.45 * vignette;\n    COLOR = c;\n}"

