# 统一换行符，避免跨平台 diff 噪声
* text=auto eol=lf

# 文本文件显式声明
*.gd        text
*.tscn      text
*.tres      text
*.godot     text
*.md        text
*.json      text
*.cfg       text
*.shader    text
*.gdshader  text

# 二进制素材：不做换行转换，不要在 diff 里展开
*.png       binary
*.jpg       binary
*.webp      binary
*.ttf       binary
*.otf       binary
*.wav       binary
*.ogg       binary
*.mp3       binary
*.aseprite  binary

# GitHub 语言统计：不要把这些算进代码行
tests/**    linguist-vendored=false
tools/**    linguist-vendored=false
